# XAMPP MariaDB defaults
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bot_404
DB_USER=root
DB_PASSWORD=

# WhatsApp owner JID; set your own number (digits only, country code first)
OWNER_NUMBER=923000000000
PREFIX=.

# Local media retention; keep enough time to catch delayed revoke events
MEDIA_DIR=./data/media
MESSAGE_RETENTION_DAYS=30

# Local/self-hosted API backend that powers the remote commands.
# Point this at your own API server; nothing remote is required.
API_BASE_URL=http://127.0.0.1:3000
API_TIMEOUT_MS=45000
API_TTS_PATH=/api/tts
API_DOWNLOAD_PATH=/api/alldl
API_SCREENSHOT_PATH=/api/websnap
