# Copy this file to .env and fill in your own values.
# Never commit your real .env.

# Required: get your own key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Base URL of the local/self-hosted API backend that powers most commands
API_BASE_URL=http://127.0.0.1:3000

BOT_PREFIX=.
SELF_PREFIX=!!
SESSION_DIR=./auth_info_baileys
ICON_PATH=./icon.png
SIGNATURE=> BOT_404
LOG_LEVEL=info
MAX_CONCURRENT=5
GROQ_MODEL=llama-3.3-70b-versatile

YTDLP_PATH=yt-dlp
FFMPEG_LOCATION=
DOWNLOAD_MAX_MB=50
DOWNLOAD_TIMEOUT_MS=180000
DOWNLOAD_DIR=./downloads

SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_MS=15000
LOG_DIR=./logs

# WhatsApp JID (number@s.whatsapp.net) for owner-only commands
OWNER_JID=